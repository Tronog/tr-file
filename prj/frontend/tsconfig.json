/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../tsconfig.angular.json",
  "compilerOptions": {
    /* `@tr-file/file-ui` is consumed as source and compiled by this app's
       build — one type-check across it and the app, and edits to it are live in
       `ng serve`. Its own build (ng-packagr, `pnpm build:libs`) checks the
       packaged form. `@vsc-ngx/ui` comes from the vsc-ngx repo as built there
       (a `file:` dependency; `pnpm ui:build` after it changes). */
    "paths": {
      "@tr-file/file-ui": ["../libs/file-ui/src/public-api.ts"]
    }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.spec.json" }
  ]
}
