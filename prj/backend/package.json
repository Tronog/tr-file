{
  "name": "@tr-file/backend",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "//exports": "The desktop shell (prj/desktop) composes the server in-process rather than spawning it, so the pieces it needs are named here instead of being reached for by deep path.",
  "exports": {
    ".": "./dist/main.js",
    "./app": "./dist/app.js",
    "./bridge": "./dist/modules/bridge/index.js",
    "./config": "./dist/config/index.js",
    "./core": "./dist/core/index.js",
    "./files": "./dist/modules/files/index.js",
    "./git": "./dist/modules/git/index.js",
    "./operations": "./dist/modules/operations/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "hash-password": "tsx src/tools/hash-password.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
