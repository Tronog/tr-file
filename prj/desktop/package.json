{
  "name": "@tr-file/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "Electron shell running the whole tr-file stack in one process",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "pnpm build && TR_FILE_DEV=1 electron .",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tr-file/backend": "workspace:*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "electron": "^44.4.3",
    "frontend": "workspace:*",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
