/* The library as ng-packagr builds it (`pnpm --filter @tr-file/file-ui build`):
   against `@vsc-ngx/ui` as built in the vsc-ngx repo (`pnpm ui:build`), the way
   a consumer of both packages sees it. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test-setup.ts", "src/testing/**"]
}
