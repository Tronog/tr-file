{
  "name": "@tr-file/ui",
  "version": "0.1.0",
  "private": true,
  "description": "VS Code style workbench framework for Angular — shell, panels, sidebars, modals, command palette, key bindings, themes (zoneless, signal-based)",
  "type": "module",
  "sideEffects": [
    "*.scss"
  ],
  "exports": {
    "./styles": {
      "sass": "./styles/ui.scss"
    },
    "./styles/mixins": {
      "sass": "./styles/_mixins.scss"
    },
    "./styles/tokens": {
      "sass": "./styles/_tokens.scss"
    }
  },
  "scripts": {
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "peerDependencies": {
    "@angular/common": "^22.1.0",
    "@angular/core": "^22.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "jsdom": "^28.1.0",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
