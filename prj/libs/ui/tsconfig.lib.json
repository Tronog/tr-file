/* The library as ng-packagr builds it (`pnpm --filter @tr-file/ui build`). The
   workspace's apps do not consume this output: they map `@tr-file/ui` to the
   sources and compile them with their own build. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test-setup.ts", "src/testing/**"]
}
