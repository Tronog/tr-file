{
  "name": "tr-file",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:dev": "docker compose -f compose.dev.yaml up --build",
    "docker:dev:down": "docker compose -f compose.dev.yaml down -v",
    "docker:prod": "docker compose -f compose.prod.yaml up --build -d",
    "docker:prod:down": "docker compose -f compose.prod.yaml down -v"
  }
}
