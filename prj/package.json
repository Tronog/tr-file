{
  "name": "tr-file",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./libs/**\" build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:libs": "node scripts/check-library-boundaries.mjs && pnpm --filter \"./libs/**\" test",
    "demo": "pnpm --filter @tr-file/demo dev",
    "demo:build": "pnpm build:libs && pnpm --filter @tr-file/demo build:dist",
    "desktop": "pnpm --filter frontend build && pnpm --filter @tr-file/desktop start",
    "desktop:dev": "pnpm --filter frontend build && pnpm --filter @tr-file/desktop dev:static",
    "desktop:package": "pnpm build && pnpm --filter @tr-file/desktop package",
    "desktop:package:linux": "pnpm build && pnpm --filter @tr-file/desktop package:linux",
    "desktop:package:win": "pnpm build && pnpm --filter @tr-file/desktop package:win",
    "desktop:package:mac": "pnpm build && pnpm --filter @tr-file/desktop package:mac",
    "desktop:release:github": "pnpm build && pnpm --filter @tr-file/desktop package && pnpm --filter @tr-file/desktop package:mac && pnpm --filter @tr-file/desktop publish:github",
    "docker:dev": "docker compose -f compose.dev.yaml up --build",
    "docker:dev:down": "docker compose -f compose.dev.yaml down -v",
    "docker:prod": "docker compose -f compose.prod.yaml up --build -d",
    "docker:prod:down": "docker compose -f compose.prod.yaml down -v"
  }
}
